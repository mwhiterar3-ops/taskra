  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@solana/web3.js": "1.99.0",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@solana/spl-token": "0.4.15"
  }
}
