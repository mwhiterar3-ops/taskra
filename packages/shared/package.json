{
  "name": "@taskra/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./env/public": {
      "types": "./dist/env/public.d.ts",
      "default": "./dist/env/public.js"
    },
    "./env/server": {
      "types": "./dist/env/server.d.ts",
      "default": "./dist/env/server.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./testing/postgres": {
      "types": "./dist/testing/postgres.d.ts",
      "default": "./dist/testing/postgres.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "bs58": "6.0.0",
    "embedded-postgres": "17.10.0-beta.17",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
