# Taskra environment contract.
#
# Copy to `.env` and fill in the blanks. `.env` is git-ignored; never commit it.
# Every variable carries exactly one label on the line above it:
#   [PUBLIC]      inlined into the browser bundle; visible to everyone
#   [SERVER_ONLY] read by server processes only; not confidential, never sent to the browser
#   [SECRET]      confidential; set only in a secret store or local `.env`
# Values shown here are non-confidential local defaults. SECRET values are always blank.

# --- Runtime -----------------------------------------------------------------

# [SERVER_ONLY] development | test | production
NODE_ENV=development
# [SERVER_ONLY] Interface the API listens on.
API_HOST=127.0.0.1
# [SERVER_ONLY] Port the API listens on.
API_PORT=4000
# [SERVER_ONLY] Origin of the web app, used for CORS.
WEB_ORIGIN=http://localhost:3000

# --- Blockchain (server) -----------------------------------------------------

# [SERVER_ONLY] localnet | devnet | mainnet-beta
SOLANA_NETWORK=devnet
# [SERVER_ONLY] RPC endpoint. The public devnet endpoint is fine for local development.
SOLANA_RPC_URL=https://api.devnet.solana.com
# [SERVER_ONLY] Deployed Taskra program address. Blank until the program is deployed.
TASKRA_PROGRAM_ID=
# [SERVER_ONLY] USDC mint for the target network. Take it from Circle's official documentation.
USDC_MINT=

# --- Database ----------------------------------------------------------------

# [SECRET] postgres://USER:PASSWORD@HOST:PORT/DB (contains the database password).
DATABASE_URL=
# [SERVER_ONLY] Local docker-compose PostgreSQL user.
POSTGRES_USER=taskra
# [SERVER_ONLY] Local docker-compose PostgreSQL database name.
POSTGRES_DB=taskra
# [SERVER_ONLY] Host port the local docker-compose PostgreSQL is published on.
POSTGRES_PORT=5432
# [SECRET] Local docker-compose PostgreSQL password. Choose your own.
POSTGRES_PASSWORD=

# --- GitHub ------------------------------------------------------------------

# [SERVER_ONLY] GitHub OAuth app client id.
GITHUB_CLIENT_ID=
# [SECRET] GitHub OAuth app client secret.
GITHUB_CLIENT_SECRET=

# --- Frontend public config ---------------------------------------------------

# [PUBLIC] localnet | devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# [PUBLIC] RPC endpoint used by the browser.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# [PUBLIC] Deployed Taskra program address.
NEXT_PUBLIC_TASKRA_PROGRAM_ID=
# [PUBLIC] USDC mint for the target network.
NEXT_PUBLIC_USDC_MINT=
# [PUBLIC] Base URL of the Taskra API.
NEXT_PUBLIC_API_URL=http://localhost:4000
